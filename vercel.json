{
  "rewrites": [
    {
      "source": "/",
      "destination": "/gradicom.html"
    }
  ],
  "headers": [
    {
      "source": "/gradicom.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/actus/actus.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/notify-actus.js",
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/morning-alert",
      "schedule": "0 7 * * 1-6"
    },
    {
      "path": "/api/morning-alert",
      "schedule": "0 8 * * 1-6"
    }
  ],
  "functions": {
    "api/morning-alert.js": {
      "includeFiles": "gradicom.html"
    }
  }
}