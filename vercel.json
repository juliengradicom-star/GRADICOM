{
  "rewrites": [
    {
      "source": "/",
      "destination": "/gradicom.html"
    }
  ],
  "headers": [
    {
      "source": "/gradicom.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
